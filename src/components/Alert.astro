---
const { 
  type = 'info', 
  title = '', 
  children,
  className = '',
  closeable = false,
  onClose = () => {}
} = Astro.props;

const typeStyles = {
  success: 'bg-green-100 text-green-800 border-l-4 border-green-600',
  error: 'bg-red-100 text-red-800 border-l-4 border-red-600',
  warning: 'bg-yellow-100 text-yellow-800 border-l-4 border-yellow-600',
  info: 'bg-indigo-100 text-indigo-800 border-l-4 border-indigo-600',
};
---

<div class={`rounded-lg px-6 py-4 mb-4 ${typeStyles[type] || typeStyles.info} ${className}`}>
  <div class="flex justify-between items-start">
    <div>
      {title && <div class="mb-2 font-bold text-lg">{title}</div>}
      <div>{children}</div>
    </div>
    {closeable && (
      <button onclick={onClose} class="text-2xl opacity-70 hover:opacity-100">&times;</button>
    )}
  </div>
</div>
