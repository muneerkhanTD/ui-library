---
const { 
  label = '', 
  checked = false, 
  onChange = () => {},
  variant = 'default',
  size = 'md',
  className = '',
  disabled = false,
  name = '',
  value = ''
} = Astro.props;

const sizes = {
  sm: 'w-3 h-3',
  md: 'w-4 h-4',
  lg: 'w-5 h-5'
};

const checkboxClass = `${sizes[size]} text-indigo-600 rounded ${disabled ? 'opacity-50 cursor-not-allowed' : ''}`;
---

<label class={`inline-flex items-center gap-2 cursor-pointer ${disabled ? 'opacity-50' : ''} ${className}`}>
  <input 
    type="checkbox" 
    checked={checked} 
    onchange={onChange} 
    class={checkboxClass}
    disabled={disabled}
    name={name}
    value={value}
  />
  <span>{label}</span>
</label>
