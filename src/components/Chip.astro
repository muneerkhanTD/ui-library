---
const { 
  label = '', 
  removable = false, 
  onRemove = () => {},
  variant = 'default',
  className = ''
} = Astro.props;

const variants = {
  default: 'bg-indigo-100 text-indigo-700',
  outlined: 'border-2 border-indigo-600 text-indigo-700',
  filled: 'bg-indigo-600 text-white',
  success: 'bg-green-100 text-green-700',
  warning: 'bg-yellow-100 text-yellow-700',
  danger: 'bg-red-100 text-red-700'
};

const chipClass = `inline-flex items-center ${variants[variant] || variants.default} px-3 py-1 rounded-full text-sm font-semibold gap-2 ${className}`;
---

<div class={chipClass}>
  <span>{label}</span>
  {removable && (
    <button onclick={onRemove} class="ml-2 hover:opacity-70 font-bold">&times;</button>
  )}
</div>
