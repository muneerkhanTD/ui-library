---
const { 
  cols = 3, 
  children,
  gap = 'md',
  className = ''
} = Astro.props;

const gaps = {
  sm: 'gap-2',
  md: 'gap-4',
  lg: 'gap-6',
  xl: 'gap-8'
};

const columnClasses = {
  1: 'grid-cols-1',
  2: 'grid-cols-2',
  3: 'grid-cols-3',
  4: 'grid-cols-4',
  5: 'grid-cols-5',
  6: 'grid-cols-6'
};

const gridClass = `grid ${columnClasses[cols] || columnClasses[3]} ${gaps[gap] || gaps.md} ${className}`;
---

<div class={gridClass}>
  {children}
</div>
