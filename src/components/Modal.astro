---
const { 
  open = false, 
  title = "Modal Title", 
  children,
  size = 'md',
  onClose = () => {},
  showCloseButton = true
} = Astro.props;

const sizes = {
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl'
};
---

{open && (
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50">
    <div class={`bg-white rounded-lg shadow-lg ${sizes[size] || sizes.md} w-full p-6`}>
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold">{title}</h3>
        {showCloseButton && (
          <button onclick={onClose} class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
        )}
      </div>
      <div>{children}</div>
    </div>
  </div>
)}
