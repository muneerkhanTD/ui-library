---
const { 
  value = 0, 
  max = 100,
  variant = 'default',
  showLabel = false,
  className = ''
} = Astro.props;

const variants = {
  default: 'bg-indigo-600',
  success: 'bg-green-600',
  warning: 'bg-yellow-600',
  danger: 'bg-red-600',
  info: 'bg-blue-600'
};

const percentage = Math.min((value / max) * 100, 100);
---

<div class={`w-full bg-gray-200 rounded-full h-3 ${className}`}>
  <div 
    class={`${variants[variant] || variants.default} h-3 rounded-full transition-all duration-300`} 
    style={`width: ${percentage}%`}
  ></div>
</div>
{showLabel && (
  <div class="text-sm text-gray-600 mt-1">{Math.round(percentage)}% Complete</div>
)}
