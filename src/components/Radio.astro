---
const { 
  name = '', 
  value = '', 
  label = '', 
  checked = false, 
  onChange = () => {},
  size = 'md',
  className = '',
  disabled = false
} = Astro.props;

const sizes = {
  sm: 'w-3 h-3',
  md: 'w-4 h-4',
  lg: 'w-5 h-5'
};

const radioClass = `${sizes[size]} text-indigo-600 ${disabled ? 'opacity-50 cursor-not-allowed' : ''}`;
---

<label class={`inline-flex items-center gap-2 cursor-pointer ${disabled ? 'opacity-50' : ''} ${className}`}>
  <input 
    type="radio" 
    name={name} 
    value={value} 
    checked={checked} 
    onchange={onChange} 
    class={radioClass}
    disabled={disabled}
  />
  <span>{label}</span>
</label>
