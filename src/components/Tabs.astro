---
const { tabs = [], active = 0, onTabChange = () => {} } = Astro.props;
---
<div class="flex gap-2 border-b border-gray-200 mb-4">
  {tabs.map((tab, i) => (
    <button class={`px-4 py-2 font-semibold ${active === i ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-gray-600'}`} onclick={() => onTabChange(i)}>{tab}</button>
  ))}
</div>
