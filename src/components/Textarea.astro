---
const { 
  value = '', 
  placeholder = '', 
  rows = 5, 
  onChange = () => {},
  size = 'md',
  className = '',
  disabled = false,
  required = false,
  maxLength = undefined,
  name = ''
} = Astro.props;

const sizes = {
  sm: 'text-sm px-2 py-1',
  md: 'text-base px-3 py-2',
  lg: 'text-lg px-4 py-3'
};

const baseClass = 'w-full rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 disabled:opacity-50';
const textareaClass = `${baseClass} ${sizes[size]} ${className}`;
---

<textarea
  class={textareaClass}
  placeholder={placeholder}
  rows={rows}
  value={value}
  onchange={onChange}
  disabled={disabled}
  required={required}
  maxlength={maxLength}
  name={name}
></textarea>
