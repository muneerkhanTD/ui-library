---
import { cn } from '../utils/classnames';

const {
  text = '',
  position = 'top',
  variant = 'dark',
  size = 'md',
  class: extraClass = '',
} = Astro.props;

const tooltipClass = cn(
  'absolute px-3 py-2 rounded text-sm font-medium whitespace-nowrap z-50 pointer-events-none',
  variant === 'dark' && 'bg-gray-900 text-white',
  variant === 'light' && 'bg-white text-gray-900 border border-gray-200',
  size === 'sm' && 'text-xs px-2 py-1',
  size === 'lg' && 'text-base px-4 py-3',
  position === 'top' && 'bottom-full mb-2 left-1/2 -translate-x-1/2',
  position === 'bottom' && 'top-full mt-2 left-1/2 -translate-x-1/2',
  position === 'left' && 'right-full mr-2 top-1/2 -translate-y-1/2',
  position === 'right' && 'left-full ml-2 top-1/2 -translate-y-1/2',
  extraClass
);
---

<div class="relative inline-block group">
  <slot />
  <div class={cn(tooltipClass, 'opacity-0 group-hover:opacity-100 transition-opacity duration-200')}>
    {text}
  </div>
</div>

