---
const { 
  text = '', 
  children,
  position = 'top',
  className = ''
} = Astro.props;

const positions = {
  top: 'bottom-full mb-2 left-1/2 -translate-x-1/2',
  bottom: 'top-full mt-2 left-1/2 -translate-x-1/2',
  left: 'right-full mr-2 top-1/2 -translate-y-1/2',
  right: 'left-full ml-2 top-1/2 -translate-y-1/2'
};

let show = false;
---

<span class={`relative inline-block ${className}`} onmouseenter={() => show = true} onmouseleave={() => show = false}>
  {children}
  {show && (
    <span class={`absolute ${positions[position] || positions.top} px-3 py-1 bg-gray-900 text-white text-xs rounded shadow-lg z-10 whitespace-nowrap`}>
      {text}
    </span>
  )}
</span>
