---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

const postRes = await fetch('https://jsonplaceholder.typicode.com/posts?_limit=12');
const postData = await postRes.json();

const blogCategories = [
  { name: "Web Development", count: 8, icon: "🌐" },
  { name: "UI/UX Design", count: 12, icon: "🎨" },
  { name: "Performance", count: 5, icon: "⚡" },
  { name: "TD Updates", count: 3, icon: "📰" }
];

const featuredPost = postData[0];
const recentPosts = postData.slice(1);
---

<BaseLayout title="Blog - TD UI Library" description="Read our latest blog posts about web development, UI components, and .NET integration.">
  <!-- Hero Section -->
  <section class="bg-linear-to-br from-indigo-600 via-purple-600 to-pink-600 text-white py-24 px-6 mb-16">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">TD Blog</h1>
      <p class="text-xl text-indigo-100 mb-8">
        Insights on modern web development, UI components, and best practices for building beautiful applications with .NET and beyond.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <input 
          type="text" 
          placeholder="Search articles..." 
          class="px-6 py-3 rounded-full text-gray-900 w-full md:w-80 focus:outline-none focus:ring-2 focus:ring-pink-400"
        />
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-6 mb-20">
    <!-- Featured Post -->
    <div class="mb-20">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="md:col-span-2">
          <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl overflow-hidden border border-indigo-200 hover:shadow-2xl transition-shadow duration-300">
            <div class="bg-linear-to-r from-indigo-500 to-purple-500 h-64 flex items-center justify-center">
              <div class="text-6xl">📌</div>
            </div>
            <div class="p-8">
              <div class="flex gap-3 mb-4">
                <span class="inline-block bg-indigo-100 text-indigo-700 px-4 py-1 rounded-full text-sm font-semibold">Featured</span>
                <span class="inline-block bg-purple-100 text-purple-700 px-4 py-1 rounded-full text-sm font-semibold">UI/UX Design</span>
              </div>
              <h2 class="text-3xl font-bold text-gray-900 mb-4 leading-tight">
                {featuredPost.title}
              </h2>
              <div class="flex items-center gap-4 text-gray-600 text-sm mb-6">
                <span>📅 January 7, 2026</span>
                <span>⏱️ 8 min read</span>
                <span>👤 Sarah Chen</span>
              </div>
              <p class="text-gray-700 text-lg leading-relaxed mb-6">
                {featuredPost.body.substring(0, 200)}...
              </p>
              <a href="/blog/featured" class="inline-block bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-8 py-3 rounded-lg font-semibold hover:shadow-lg transition">
                Read Full Article →
              </a>
            </div>
          </div>
        </div>
        
        <!-- Categories Sidebar -->
        <div>
          <div class="bg-white rounded-2xl border border-gray-200 p-8 h-fit sticky top-20">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Categories</h3>
            <div class="space-y-4">
              {blogCategories.map(category => (
                <div class="flex items-center justify-between p-4 rounded-lg hover:bg-indigo-50 cursor-pointer transition">
                  <div class="flex items-center gap-3">
                    <span class="text-2xl">{category.icon}</span>
                    <div>
                      <p class="font-semibold text-gray-900">{category.name}</p>
                      <p class="text-sm text-gray-600">{category.count} articles</p>
                    </div>
                  </div>
                  <span class="text-indigo-600 font-bold">→</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Posts Grid -->
    <div>
      <div class="mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-3">Latest Articles</h2>
        <p class="text-lg text-gray-600">Stay updated with the newest posts from our team</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {recentPosts.map((post, index) => (
          <div class="group bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-xl hover:border-indigo-300 transition-all duration-300">
            <!-- Post Header -->
            <div class="bg-gradient-to-br from-indigo-400 to-purple-400 h-40 flex items-center justify-center relative overflow-hidden">
              <div class="text-5xl group-hover:scale-110 transition-transform duration-300">
                {index % 4 === 0 ? "🚀" : index % 4 === 1 ? "💡" : index % 4 === 2 ? "🎯" : "✨"}
              </div>
            </div>
            
            <!-- Post Content -->
            <div class="p-6">
              <div class="flex gap-2 mb-3">
                <span class="text-xs bg-indigo-100 text-indigo-700 px-3 py-1 rounded-full font-semibold">
                  {index % 3 === 0 ? "Development" : index % 3 === 1 ? "Components" : "Tutorial"}
                </span>
              </div>
              
              <h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2 group-hover:text-indigo-600 transition">
                {post.title}
              </h3>
              
              <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                {post.body.substring(0, 120)}...
              </p>
              
              <div class="flex items-center justify-between text-sm text-gray-500 mb-4 pb-4 border-b border-gray-200">
                <span>⏱️ 5 min read</span>
                <span>👤 {index % 2 === 0 ? "Alex" : "Jordan"}</span>
              </div>
              
              <a href={`/blog/post/${post.id}`} class="text-indigo-600 font-semibold hover:text-purple-600 transition">
                Read More →
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Load More Button -->
      <div class="flex justify-center mb-20">
        <button class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-12 py-4 rounded-full font-semibold hover:shadow-lg transition-all duration-300 hover:scale-105">
          Load More Articles
        </button>
      </div>
    </div>

    <!-- Newsletter Section -->
    <section class="bg-linear-to-br from-indigo-600 via-purple-600 to-pink-600 rounded-2xl p-12 text-white mb-16">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl font-bold mb-4">Never Miss an Update</h2>
        <p class="text-lg text-indigo-100 mb-8">
          Subscribe to our newsletter for weekly insights on UI design, web development, and .NET best practices.
        </p>
        <div class="flex gap-3 flex-col md:flex-row md:max-w-md mx-auto">
          <input 
            type="email" 
            placeholder="your@email.com" 
            class="px-6 py-3 rounded-lg text-gray-900 flex-1 focus:outline-none focus:ring-2 focus:ring-pink-300"
          />
          <button class="bg-white text-indigo-600 px-8 py-3 rounded-lg font-bold hover:bg-indigo-50 transition">
            Subscribe
          </button>
        </div>
      </div>
    </section>

    <!-- Author Showcase -->
    <section class="mb-20">
      <h2 class="text-4xl font-bold text-gray-900 mb-12 text-center">Meet Our Authors</h2>
      <div class="grid md:grid-cols-4 gap-8">
        {[
          { name: "Sarah Chen", role: "UI Designer", avatar: "👩‍💻" },
          { name: "Alex Rivera", role: "Full Stack Dev", avatar: "👨‍💻" },
          { name: "Jordan Lee", role: "DevOps Engineer", avatar: "👨‍🔧" },
          { name: "Emma Watson", role: "Product Lead", avatar: "👩‍💼" }
        ].map(author => (
          <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center hover:shadow-lg transition">
            <div class="text-6xl mb-4">{author.avatar}</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">{author.name}</h3>
            <p class="text-gray-600 mb-4">{author.role}</p>
            <div class="flex gap-3 justify-center">
              <a href="#" class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center hover:bg-indigo-600 hover:text-white transition">
                f
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center hover:bg-indigo-600 hover:text-white transition">
                𝕏
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center hover:bg-indigo-600 hover:text-white transition">
                in
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>

  <Footer />
</BaseLayout>
