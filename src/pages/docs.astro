---
import MainLayout from "../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

const components = await getCollection('components');
---
<MainLayout title="Documentation" description="Comprehensive documentation for DevPath UI Library components, including usage guidelines and examples.">
  <h1 class="text-4xl font-bold mb-6">Components Documentation</h1>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <ul>
        <li>
            {components.map((item) => (
            <a href={`/docs/${item.slug}`} class="block p-4 border border-gray-200 rounded-lg hover:shadow-lg transition-shadow">
                <h2 class="text-2xl font-semibold mb-2">{item.data.name}</h2>
                <p class="text-gray-600">{item.data.description}</p>
            </a>
            ))}
        </li>
    </ul>
  </div>