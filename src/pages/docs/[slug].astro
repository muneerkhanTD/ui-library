      { name: "Default", code: '<span class="bg-gray-100 text-gray-900 px-3 py-1 rounded-full text-sm">Tag</span>', props: { variant: "default" } },
      { name: "Removable", code: '<span class="bg-gray-100 text-gray-900 px-3 py-1 rounded-full text-sm flex items-center gap-2">Tag <button>×</button></span>', props: { removable: true } }
    ],
    api: [
      { prop: "label", type: "string", default: "-", description: "Chip label" },
      { prop: "removable", type: "boolean", default: "false", description: "Can remove chip" },
      { prop: "variant", type: "string", default: "default", description: "Chip style" }
    ],
    usage: `<Chip label="JavaScript" removable={true} />`
  },
  select: {
    name: "Select",
    icon: "📋",
    description: "Dropdown select input.",
    category: "Form",
    variants: [
      { name: "Default", code: '<select class="px-4 py-2 border border-gray-300 rounded-lg"><option>Option 1</option></select>', props: { variant: "default" } },
      { name: "Multiple", code: '<select multiple class="px-4 py-2 border border-gray-300 rounded-lg"><option>Option 1</option></select>', props: { multiple: true } }
    ],
    api: [
      { prop: "options", type: "array", default: "[]", description: "Select options" },
      { prop: "placeholder", type: "string", default: "-", description: "Placeholder text" },
      { prop: "multiple", type: "boolean", default: "false", description: "Multiple selection" },
      { prop: "size", type: "string", default: "md", description: "Select size" }
    ],
    usage: `<Select options={[{label: 'Option 1', value: '1'}]} />`
  },
  textarea: {
    name: "Textarea",
    icon: "📄",
    description: "Multi-line text input.",
    category: "Form",
    variants: [
      { name: "Default", code: '<textarea class="px-4 py-2 border border-gray-300 rounded-lg" rows="5"></textarea>', props: { variant: "default" } }
    ],
    api: [
      { prop: "placeholder", type: "string", default: "-", description: "Placeholder text" },
      { prop: "rows", type: "number", default: "5", description: "Number of rows" },
      { prop: "maxLength", type: "number", default: "-", description: "Max character count" },
      { prop: "size", type: "string", default: "md", description: "Textarea size" }
    ],
    usage: `<Textarea placeholder="Enter text..." rows={5} />`
  },
  alert: {
    name: "Alert",
    icon: "⚠️",
    description: "Alert messages for notifications.",
    category: "Feedback",
    variants: [
      { name: "Success", code: '<div class="bg-green-50 border border-green-200 text-green-700 p-4 rounded-lg">Success message</div>', props: { type: "success" } },
      { name: "Error", code: '<div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg">Error message</div>', props: { type: "error" } },
      { name: "Warning", code: '<div class="bg-yellow-50 border border-yellow-200 text-yellow-700 p-4 rounded-lg">Warning message</div>', props: { type: "warning" } },
      { name: "Info", code: '<div class="bg-blue-50 border border-blue-200 text-blue-700 p-4 rounded-lg">Info message</div>', props: { type: "info" } }
    ],
    api: [
      { prop: "type", type: "string", default: "info", description: "Alert type: success, error, warning, info" },
      { prop: "title", type: "string", default: "-", description: "Alert title" },
      { prop: "closeable", type: "boolean", default: "false", description: "Can close alert" }
    ],
    usage: `<Alert type="warning" title="Warning" closeable={true} />`
  },
  link: {
    name: "Link",
    icon: "🔗",
    description: "Styled link component.",
    category: "Navigation",
    variants: [
      { name: "Default", code: '<a href="#" class="text-indigo-600 hover:text-indigo-700">Link</a>', props: { variant: "default" } },
      { name: "Underline", code: '<a href="#" class="text-indigo-600 underline hover:text-indigo-700">Link</a>', props: { variant: "underline" } },
      { name: "Button", code: '<a href="#" class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700">Link</a>', props: { variant: "button" } }
    ],
    api: [
      { prop: "text", type: "string", default: "-", description: "Link text" },
      { prop: "href", type: "string", default: "-", description: "Link URL" },
      { prop: "variant", type: "string", default: "default", description: "Link style" },
      { prop: "size", type: "string", default: "md", description: "Link size" }
    ],
    usage: `<Link text="Click here" href="/page" variant="default" />`
  },
  list: {
    name: "List",
    icon: "📝",
    description: "Ordered and unordered lists.",
    category: "Layout",
    variants: [
      { name: "Unordered", code: '<ul><li>Item 1</li><li>Item 2</li></ul>', props: { ordered: false } },
      { name: "Ordered", code: '<ol><li>Item 1</li><li>Item 2</li></ol>', props: { ordered: true } }
    ],
    api: [
      { prop: "items", type: "array", default: "[]", description: "List items" },
      { prop: "ordered", type: "boolean", default: "false", description: "Ordered list" }
    ],
    usage: `<List items={['Item 1', 'Item 2']} ordered={false} />`
  },
  divider: {
    name: "Divider",
    icon: "─",
    description: "Content separator.",
    category: "Layout",
    variants: [
      { name: "Horizontal", code: '<hr class="border-t border-gray-300"/>', props: { orientation: "horizontal" } },
      { name: "Vertical", code: '<div class="border-l border-gray-300 h-full"></div>', props: { orientation: "vertical" } }
    ],
    api: [
      { prop: "orientation", type: "string", default: "horizontal", description: "Divider direction" },
      { prop: "variant", type: "string", default: "solid", description: "Divider style: solid, dashed, dotted" }
    ],
    usage: `<Divider orientation="horizontal" />`
  },
  stack: {
    name: "Stack",
    icon: "📚",
    description: "Flexible layout stacking.",
    category: "Layout",
    variants: [
      { name: "Vertical", code: '<div class="flex flex-col gap-4"><div>Item 1</div><div>Item 2</div></div>', props: { direction: "column" } },
      { name: "Horizontal", code: '<div class="flex flex-row gap-4"><div>Item 1</div><div>Item 2</div></div>', props: { direction: "row" } }
    ],
    api: [
      { prop: "direction", type: "string", default: "column", description: "Stack direction: row, column" },
      { prop: "gap", type: "string", default: "md", description: "Gap size: sm, md, lg" }
    ],
    usage: `<Stack direction="column" gap="md">Items</Stack>`
  },
  grid: {
    name: "Grid",
    icon: "⊞",
    description: "CSS Grid layout.",
    category: "Layout",
    variants: [
      { name: "2 Columns", code: '<div class="grid grid-cols-2 gap-4"><div>Item 1</div><div>Item 2</div></div>', props: { cols: 2 } },
      { name: "3 Columns", code: '<div class="grid grid-cols-3 gap-4"><div>Item 1</div><div>Item 2</div><div>Item 3</div></div>', props: { cols: 3 } },
      { name: "4 Columns", code: '<div class="grid grid-cols-4 gap-4"><div>Item 1</div><div>Item 2</div><div>Item 3</div><div>Item 4</div></div>', props: { cols: 4 } }
    ],
    api: [
      { prop: "cols", type: "number", default: "3", description: "Number of columns" },
      { prop: "gap", type: "string", default: "md", description: "Gap size: sm, md, lg" }
    ],
    usage: `<Grid cols={3} gap="md">Items</Grid>`
  },
  table: {
    name: "Table",
    icon: "📊",
    description: "Data table component with columns, rows, and styling options.",
    category: "Data",
    variants: [
      { name: "Default", code: '<table><thead><tr><th>Name</th><th>Email</th></tr></thead><tbody><tr><td>John</td><td>john@example.com</td></tr></tbody></table>', props: { striped: false } },
      { name: "Striped", code: '<table><thead><tr><th>Name</th><th>Email</th></tr></thead><tbody><tr class="bg-gray-50"><td>John</td><td>john@example.com</td></tr></tbody></table>', props: { striped: true } },
      { name: "Bordered", code: '<table class="border"><thead><tr class="border"><th class="border px-4">Name</th><th class="border px-4">Email</th></tr></thead></table>', props: { bordered: true } },
      { name: "Hoverable", code: '<table><tbody><tr class="hover:bg-indigo-50"><td>John</td><td>john@example.com</td></tr></tbody></table>', props: { hover: true } }
    ],
    api: [
      { prop: "columns", type: "array", default: "[]", description: "Column headers" },
      { prop: "rows", type: "array", default: "[]", description: "Table rows" },
      { prop: "striped", type: "boolean", default: "false", description: "Alternate row colors" },
      { prop: "hover", type: "boolean", default: "true", description: "Row hover effects" },
      { prop: "bordered", type: "boolean", default: "true", description: "Show borders" }
    ],
    usage: `<Table columns={['Name', 'Email']} rows={[{name: 'John', email: 'john@example.com'}]} />`
  },
  dropdown: {
    name: "Dropdown",
    icon: "▼",
    description: "Dropdown menu component for displaying action items.",
    category: "Navigation",
    variants: [
      { name: "Primary", code: '<button class="bg-indigo-600 text-white px-4 py-2 rounded-lg">Menu ▼</button>', props: { variant: "primary" } },
      { name: "Secondary", code: '<button class="bg-gray-100 text-gray-900 px-4 py-2 rounded-lg">Menu ▼</button>', props: { variant: "secondary" } },
      { name: "Outline", code: '<button class="border border-gray-300 px-4 py-2 rounded-lg">Menu ▼</button>', props: { variant: "outline" } },
      { name: "Small", code: '<button class="bg-indigo-600 text-white px-3 py-1 text-sm rounded">Menu ▼</button>', props: { size: "sm" } },
      { name: "Large", code: '<button class="bg-indigo-600 text-white px-6 py-3 rounded-lg">Menu ▼</button>', props: { size: "lg" } }
    ],
    api: [
      { prop: "trigger", type: "string", default: "Menu", description: "Button trigger text" },
      { prop: "items", type: "array", default: "[]", description: "Menu items with label and href" },
      { prop: "position", type: "string", default: "bottom", description: "Dropdown position: top, bottom, left, right" },
      { prop: "variant", type: "string", default: "primary", description: "Button variant" },
      { prop: "size", type: "string", default: "md", description: "Button size: sm, md, lg" }
    ],
    usage: `<Dropdown trigger="Menu" items={[{label: 'Item 1', href: '#'}, {label: 'Item 2', href: '#'}]} />`
  },
  tooltip: {
    name: "Tooltip",
    icon: "💬",
    description: "Contextual help tooltips that appear on hover.",
    category: "Feedback",
    variants: [
      { name: "Top", code: '<div class="relative inline-block"><button>Hover me</button><div class="absolute bottom-full bg-gray-900 text-white px-3 py-2 rounded text-sm">Tooltip</div></div>', props: { position: "top" } },
      { name: "Bottom", code: '<div class="relative inline-block"><button>Hover me</button><div class="absolute top-full bg-gray-900 text-white px-3 py-2 rounded text-sm mt-2">Tooltip</div></div>', props: { position: "bottom" } },
      { name: "Dark", code: '<div class="bg-gray-900 text-white px-3 py-2 rounded text-sm">Dark tooltip</div>', props: { variant: "dark" } },
      { name: "Light", code: '<div class="bg-white text-gray-900 border border-gray-200 px-3 py-2 rounded text-sm">Light tooltip</div>', props: { variant: "light" } }
    ],
    api: [
      { prop: "text", type: "string", default: "-", description: "Tooltip text" },
      { prop: "position", type: "string", default: "top", description: "Position: top, bottom, left, right" },
      { prop: "variant", type: "string", default: "dark", description: "Style: dark, light" },
      { prop: "size", type: "string", default: "md", description: "Size: sm, md, lg" }
    ],
    usage: `<Tooltip text="Help text" position="top"><button>Hover me</button></Tooltip>`
  },
  stepper: {
    name: "Stepper",
    icon: "📍",
    description: "Multi-step form indicator showing progress through steps.",
    category: "Feedback",
    variants: [
      { name: "Horizontal", code: '<div class="flex gap-4"><div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center">1</div><div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center">2</div></div>', props: { variant: "horizontal" } },
      { name: "Vertical", code: '<div class="flex flex-col gap-4"><div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center">1</div><div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center">2</div></div>', props: { variant: "vertical" } },
      { name: "Small", code: '<div class="flex gap-4"><div class="w-6 h-6 rounded-full bg-indigo-600 text-white text-xs flex items-center justify-center">1</div></div>', props: { size: "sm" } },
      { name: "Large", code: '<div class="flex gap-4"><div class="w-10 h-10 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold">1</div></div>', props: { size: "lg" } }
    ],
    api: [
      { prop: "steps", type: "array", default: "[]", description: "Step items with label" },
      { prop: "activeStep", type: "number", default: "0", description: "Current active step" },
      { prop: "variant", type: "string", default: "horizontal", description: "Layout: horizontal, vertical" },
      { prop: "size", type: "string", default: "md", description: "Size: sm, md, lg" }
    ],
    usage: `<Stepper steps={['Step 1', 'Step 2', 'Step 3']} activeStep={0} variant="horizontal" />`
  },
  breadcrumb: {
    name: "Breadcrumb",
    icon: "🔗",
    description: "Navigation breadcrumbs showing current page hierarchy.",
    category: "Navigation",
    variants: [
      { name: "Default", code: '<nav class="flex gap-2"><a href="#" class="text-indigo-600">Home</a><span>/</span><span>Current Page</span></nav>', props: { variant: "default" } },
      { name: "With Icons", code: '<nav class="flex gap-2"><a href="#">🏠 Home</a><span>/</span><span>📄 Page</span></nav>', props: { variant: "default" } },
      { name: "Small", code: '<nav class="flex gap-2 text-sm"><a href="#" class="text-indigo-600">Home</a><span>/</span><span>Page</span></nav>', props: { size: "sm" } },
      { name: "Large", code: '<nav class="flex gap-2 text-lg"><a href="#" class="text-indigo-600">Home</a><span>/</span><span>Page</span></nav>', props: { size: "lg" } }
    ],
    api: [
      { prop: "items", type: "array", default: "[]", description: "Breadcrumb items with label and href" },
      { prop: "variant", type: "string", default: "default", description: "Display style" },
      { prop: "size", type: "string", default: "md", description: "Size: sm, md, lg" }
    ],
    usage: `<Breadcrumb items={[{label: 'Home', href: '/'}, {label: 'Products', href: '/products'}, {label: 'Current'}]} />`
  }
};

const component = componentDocs[slug as keyof typeof componentDocs];

if (!component) {
  return Astro.redirect('/components');
}
---

<BaseLayout title={`${component.name} - TD Components`} description={component.description}>
  <!-- Navigation Breadcrumb -->
  <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 text-sm">
        <a href="/components" class="text-indigo-600 hover:text-indigo-700">Components</a>
        <span class="text-gray-400">/</span>
        <span class="text-gray-600">{component.name}</span>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 py-16">
    <!-- Header Section -->
    <div class="mb-16 border-b border-gray-200 pb-12">
      <div class="flex items-start gap-6 mb-6">
        <div class="text-6xl">{component.icon}</div>
        <div class="flex-1">
          <h1 class="text-5xl font-bold text-gray-900 mb-3">{component.name}</h1>
          <p class="text-xl text-gray-600 mb-4">{component.description}</p>
          <div class="flex gap-3">
            <span class="inline-block bg-indigo-100 text-indigo-700 px-4 py-2 rounded-full text-sm font-semibold">
              {component.category}
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Two Column Layout -->
    <div class="mb-20">
      <!-- Main Content -->
        <!-- Variants Section -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold text-gray-900 mb-8">Variants</h2>
          <div class="grid md:grid-cols-3 gap-8">
            {component.variants.map((variant, index) => (
              <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-lg transition">
                <!-- Preview -->
                <div class="bg-gradient-to-br from-gray-50 to-gray-100 p-8 min-h-40 flex items-center justify-center border-b border-gray-200">
                  <div set:html={variant.code} />
                </div>

                <!-- Info -->
                <div class="p-6">
                  <h3 class="text-lg font-bold text-gray-900 mb-3">{variant.name}</h3>
                  
                  <!-- Props -->
                  <div class="mb-4">
                    <p class="text-xs font-semibold text-gray-700 mb-2">Props:</p>
                    <div class="space-y-1">
                      {Object.entries(variant.props).map(([key, value]) => (
                        <code class="text-xs text-gray-600 block">{key}="{String(value)}"</code>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- API Documentation -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold text-gray-900 mb-8">Props / API</h2>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-gray-50 border-b-2 border-gray-200">
                  <th class="text-left px-6 py-4 font-bold text-gray-900">Prop</th>
                  <th class="text-left px-6 py-4 font-bold text-gray-900">Type</th>
                  <th class="text-left px-6 py-4 font-bold text-gray-900">Default</th>
                  <th class="text-left px-6 py-4 font-bold text-gray-900">Description</th>
                </tr>
              </thead>
              <tbody>
                {component.api.map((row) => (
                  <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="px-6 py-4"><code class="text-indigo-600 font-semibold">{row.prop}</code></td>
                    <td class="px-6 py-4"><code class="text-gray-600 text-sm">{row.type}</code></td>
                    <td class="px-6 py-4"><code class="text-gray-600 text-sm">{row.default}</code></td>
                    <td class="px-6 py-4 text-gray-600">{row.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Usage Section -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold text-gray-900 mb-8">Usage</h2>
          <div class="bg-gray-900 rounded-2xl p-6">
            <pre class="text-green-400 font-mono text-sm overflow-x-auto"><code>{component.usage}</code></pre>
          </div>
        </section>
    </div>
  </div>

  <Footer />
</BaseLayout>
