---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  return [
    { params: { slug: 'button' } },
    { params: { slug: 'card' } },
    { params: { slug: 'badge' } },
    { params: { slug: 'avatar' } },
    { params: { slug: 'input' } },
    { params: { slug: 'table' } },
    { params: { slug: 'dropdown' } },
    { params: { slug: 'tooltip' } },
    { params: { slug: 'toast' } },
    { params: { slug: 'spinner' } },
    { params: { slug: 'checkbox' } },
    { params: { slug: 'radio' } },
    { params: { slug: 'toggle' } },
    { params: { slug: 'stepper' } },
    { params: { slug: 'breadcrumb' } },
    { params: { slug: 'progress' } },
    { params: { slug: 'chip' } },
    { params: { slug: 'select' } },
    { params: { slug: 'textarea' } },
    { params: { slug: 'alert' } },
    { params: { slug: 'link' } },
    { params: { slug: 'list' } },
    { params: { slug: 'divider' } },
    { params: { slug: 'stack' } },
    { params: { slug: 'grid' } },
    { params: { slug: 'modal' } },
    { params: { slug: 'navbar' } },
    { params: { slug: 'sidebar' } },
    { params: { slug: 'pagination' } },
    { params: { slug: 'tabs' } },
    { params: { slug: 'accordion' } },
  ];
}

const { slug } = Astro.params;

const componentDocs = {
  button: {
    name: "Button",
    icon: "🔘",
    description: "A versatile button component with multiple variants, sizes, and states for different use cases.",
    category: "Form",
    variants: [
      { 
        name: "Primary", 
        code: '<button class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition">Click Me</button>',
        props: { variant: "primary", size: "md" }
      },
      { 
        name: "Secondary", 
        code: '<button class="bg-gray-200 text-gray-900 px-6 py-2 rounded-lg font-semibold hover:bg-gray-300 transition">Click Me</button>',
        props: { variant: "secondary", size: "md" }
      },
      { 
        name: "Outline", 
        code: '<button class="border-2 border-indigo-600 text-indigo-600 px-6 py-2 rounded-lg font-semibold hover:bg-indigo-50 transition">Click Me</button>',
        props: { variant: "outline", size: "md" }
      },
      { 
        name: "Danger", 
        code: '<button class="bg-red-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-red-700 transition">Delete</button>',
        props: { variant: "danger", size: "md" }
      },
      { 
        name: "Small", 
        code: '<button class="bg-indigo-600 text-white px-3 py-1 rounded text-sm font-semibold hover:bg-indigo-700 transition">Sm</button>',
        props: { variant: "primary", size: "sm" }
      },
      { 
        name: "Large", 
        code: '<button class="bg-indigo-600 text-white px-8 py-3 rounded-lg text-lg font-semibold hover:bg-indigo-700 transition">Large</button>',
        props: { variant: "primary", size: "lg" }
      },
      { 
        name: "Disabled", 
        code: '<button class="bg-gray-400 text-white px-6 py-2 rounded-lg font-semibold cursor-not-allowed opacity-50" disabled>Disabled</button>',
        props: { variant: "primary", size: "md", disabled: true }
      },
      { 
        name: "With Icon", 
        code: '<button class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition flex items-center gap-2">➕ Add Item</button>',
        props: { variant: "primary", size: "md", icon: true }
      }
    ],
    api: [
      { prop: "variant", type: "string", default: "primary", description: "Button style variant: primary, secondary, outline, danger, link" },
      { prop: "size", type: "string", default: "md", description: "Button size: sm, md, lg" },
      { prop: "disabled", type: "boolean", default: "false", description: "Disable the button" },
      { prop: "href", type: "string", default: "-", description: "Link URL (renders as anchor tag)" },
      { prop: "type", type: "string", default: "button", description: "Button type: button, submit, reset" },
      { prop: "className", type: "string", default: "-", description: "Additional CSS classes" }
    ],
    usage: `<!-- Basic Button -->
<Button>Click Me</Button>

<!-- With Variant -->
<Button variant="secondary">Click Me</Button>

<!-- With Size -->
<Button size="lg">Click Me</Button>

<!-- As Link -->
<Button href="/page">Go to Page</Button>

<!-- Disabled State -->
<Button disabled>Disabled</Button>`
  },
  card: {
    name: "Card",
    icon: "📋",
    description: "A flexible card component perfect for grouping and displaying content in a contained, organized manner.",
    category: "Layout",
    variants: [
      { 
        name: "Default", 
        code: '<div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-lg transition"><h3>Card Title</h3><p>Card content goes here</p></div>',
        props: { variant: "default" }
      },
      { 
        name: "Elevated", 
        code: '<div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-2xl transition"><h3>Card Title</h3><p>Card content goes here</p></div>',
        props: { variant: "elevated" }
      },
      { 
        name: "Outlined", 
        code: '<div class="bg-white rounded-2xl border-2 border-indigo-200 p-6 hover:border-indigo-400 transition"><h3>Card Title</h3><p>Card content goes here</p></div>',
        props: { variant: "outlined" }
      },
      { 
        name: "With Image", 
        code: '<div class="bg-white rounded-2xl border border-gray-200 overflow-hidden"><img src="image.jpg" class="w-full h-48 object-cover"/><div class="p-6"><h3>Card Title</h3><p>Card content</p></div></div>',
        props: { variant: "default", hasImage: true }
      },
      { 
        name: "Compact", 
        code: '<div class="bg-white rounded-lg border border-gray-200 p-4"><h4>Title</h4><p class="text-sm">Content</p></div>',
        props: { variant: "default", compact: true }
      },
      { 
        name: "With Hover", 
        code: '<div class="bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-xl hover:border-indigo-300 cursor-pointer transition-all"><h3>Hoverable Card</h3><p>Hover me</p></div>',
        props: { variant: "default", hoverable: true }
      }
    ],
    api: [
      { prop: "variant", type: "string", default: "default", description: "Card style: default, elevated, outlined" },
      { prop: "padding", type: "string", default: "md", description: "Padding size: sm, md, lg" },
      { prop: "hoverable", type: "boolean", default: "false", description: "Add hover effects" },
      { prop: "compact", type: "boolean", default: "false", description: "Use compact padding" },
      { prop: "className", type: "string", default: "-", description: "Additional CSS classes" }
    ],
    usage: `<!-- Basic Card -->
<Card>
  <h3>Card Title</h3>
  <p>Card content</p>
</Card>

<!-- Elevated Card -->
<Card variant="elevated">
  <h3>Important Card</h3>
</Card>

<!-- With Image -->
<Card>
  <img src="image.jpg" />
  <div class="p-6">
    <h3>Title</h3>
  </div>
</Card>`
  },
  badge: {
    name: "Badge",
    icon: "🏷️",
    description: "A compact component perfect for displaying status labels, category tags, and badges.",
    category: "Display",
    variants: [
      { 
        name: "Primary", 
        code: '<span class="bg-indigo-100 text-indigo-700 px-3 py-1 rounded-full text-sm font-semibold">Active</span>',
        props: { variant: "primary" }
      },
      { 
        name: "Success", 
        code: '<span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-semibold">Success</span>',
        props: { variant: "success" }
      },
      { 
        name: "Warning", 
        code: '<span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm font-semibold">Warning</span>',
        props: { variant: "warning" }
      },
      { 
        name: "Error", 
        code: '<span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-semibold">Error</span>',
        props: { variant: "error" }
      },
      { 
        name: "Outline", 
        code: '<span class="border-2 border-indigo-300 text-indigo-700 px-3 py-1 rounded-full text-sm font-semibold">Draft</span>',
        props: { variant: "outline" }
      },
      { 
        name: "With Dot", 
        code: '<span class="bg-indigo-100 text-indigo-700 px-3 py-1 rounded-full text-sm font-semibold flex items-center gap-2"><span class="w-2 h-2 bg-indigo-600 rounded-full"></span>Active</span>',
        props: { variant: "primary", withDot: true }
      }
    ],
    api: [
      { prop: "variant", type: "string", default: "primary", description: "Badge color: primary, success, warning, error, outline" },
      { prop: "size", type: "string", default: "md", description: "Badge size: sm, md, lg" },
      { prop: "pill", type: "boolean", default: "true", description: "Pill-shaped badge" },
      { prop: "dismissible", type: "boolean", default: "false", description: "Show close button" },
      { prop: "className", type: "string", default: "-", description: "Additional CSS classes" }
    ],
    usage: `<!-- Basic Badge -->
<Badge variant="primary">Active</Badge>

<!-- Success Badge -->
<Badge variant="success">Completed</Badge>

<!-- Dismissible Badge -->
<Badge variant="warning" dismissible>Warning</Badge>

<!-- In List -->
<div class="space-y-2">
  <Badge>Tag 1</Badge>
  <Badge>Tag 2</Badge>
  <Badge>Tag 3</Badge>
</div>`
  },
  avatar: {
    name: "Avatar",
    icon: "👤",
    description: "User profile avatar component with image fallback and multiple size options.",
    category: "Display",
    variants: [
      { 
        name: "Small", 
        code: '<img src="avatar.jpg" alt="User name" class="w-8 h-8 rounded-full object-cover ring-2 ring-indigo-300"/>',
        props: { size: "sm" }
      },
      { 
        name: "Medium", 
        code: '<img src="avatar.jpg" alt="User name" class="w-10 h-10 rounded-full object-cover ring-2 ring-indigo-300"/>',
        props: { size: "md" }
      },
      { 
        name: "Large", 
        code: '<img src="avatar.jpg" alt="User name" class="w-16 h-16 rounded-full object-cover ring-2 ring-indigo-300"/>',
        props: { size: "lg" }
      },
      { 
        name: "With Status", 
        code: '<div class="relative w-10 h-10"><img src="avatar.jpg" class="w-full h-full rounded-full object-cover"/><span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full ring-2 ring-white"></span></div>',
        props: { size: "md", status: "online" }
      },
      { 
        name: "Initials", 
        code: '<div class="w-10 h-10 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">MK</div>',
        props: { size: "md", fallback: "initials" }
      },
      { 
        name: "Group", 
        code: '<div class="flex -space-x-3"><img src="avatar1.jpg" class="w-10 h-10 rounded-full ring-2 ring-white"/><img src="avatar2.jpg" class="w-10 h-10 rounded-full ring-2 ring-white"/><img src="avatar3.jpg" class="w-10 h-10 rounded-full ring-2 ring-white"/></div>',
        props: { variant: "group" }
      }
    ],
    api: [
      { prop: "src", type: "string", default: "-", description: "Image source URL" },
      { prop: "alt", type: "string", default: "-", description: "Alt text for image" },
      { prop: "size", type: "string", default: "md", description: "Avatar size: sm, md, lg, xl" },
      { prop: "status", type: "string", default: "-", description: "Status indicator: online, offline, away" },
      { prop: "fallback", type: "string", default: "-", description: "Fallback: initials, icon" }
    ],
    usage: `<!-- Basic Avatar -->
<Avatar src="path/to/image.jpg" alt="User" />

<!-- With Status -->
<Avatar src="path/to/image.jpg" status="online" />

<!-- Initials Fallback -->
<Avatar fallback="MK" />

<!-- Group of Avatars -->
<AvatarGroup>
  <Avatar src="avatar1.jpg" />
  <Avatar src="avatar2.jpg" />
  <Avatar src="avatar3.jpg" />
</AvatarGroup>`
  },
  input: {
    name: "Input",
    icon: "📝",
    description: "Form input field with multiple types, sizes, and validation states.",
    category: "Form",
    variants: [
      { name: "Text", code: '<input type="text" placeholder="Enter text" class="px-4 py-2 border border-gray-300 rounded-lg"/>', props: { type: "text" } },
      { name: "Email", code: '<input type="email" placeholder="Enter email" class="px-4 py-2 border border-gray-300 rounded-lg"/>', props: { type: "email" } },
      { name: "Password", code: '<input type="password" placeholder="Enter password" class="px-4 py-2 border border-gray-300 rounded-lg"/>', props: { type: "password" } },
      { name: "Number", code: '<input type="number" placeholder="Enter number" class="px-4 py-2 border border-gray-300 rounded-lg"/>', props: { type: "number" } },
      { name: "Search", code: '<input type="search" placeholder="Search..." class="px-4 py-2 border border-gray-300 rounded-lg"/>', props: { type: "search" } },
      { name: "Disabled", code: '<input type="text" disabled class="px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 opacity-50 cursor-not-allowed"/>', props: { disabled: true } }
    ],
    api: [
      { prop: "type", type: "string", default: "text", description: "Input type: text, email, password, number, search" },
      { prop: "size", type: "string", default: "md", description: "Input size: sm, md, lg" },
      { prop: "placeholder", type: "string", default: "-", description: "Placeholder text" },
      { prop: "disabled", type: "boolean", default: "false", description: "Disable input" },
      { prop: "required", type: "boolean", default: "false", description: "Mark as required" }
    ],
    usage: `<Input type="email" placeholder="Enter email" />`
  },
  table: {
    name: "Table",
    icon: "📊",
    description: "Data table component with rows, columns, and sortable headers.",
    category: "Display",
    variants: [
      { name: "Default", code: '<table class="w-full border-collapse"><tr><th class="p-3 border">Header</th></tr><tr><td class="p-3 border">Data</td></tr></table>', props: { variant: "default" } },
      { name: "Striped", code: '<table class="w-full"><tr class="bg-gray-50"><th class="p-3">Header</th></tr><tr><td class="p-3">Data</td></tr></table>', props: { variant: "striped" } },
      { name: "Bordered", code: '<table class="w-full border-2 border-collapse"><tr><th class="p-3 border">Header</th></tr><tr><td class="p-3 border">Data</td></tr></table>', props: { variant: "bordered" } }
    ],
    api: [
      { prop: "rows", type: "array", default: "[]", description: "Table row data" },
      { prop: "columns", type: "array", default: "[]", description: "Column headers" },
      { prop: "variant", type: "string", default: "default", description: "Table style: default, striped, bordered" }
    ],
    usage: `<Table rows={data} columns={['Name', 'Email', 'Status']} />`
  },
  toast: {
    name: "Toast",
    icon: "🔔",
    description: "Notification toast messages with auto-dismiss.",
    category: "Feedback",
    variants: [
      { name: "Success", code: '<div class="bg-green-500 text-white p-4 rounded-lg">Success message</div>', props: { type: "success" } },
      { name: "Error", code: '<div class="bg-red-500 text-white p-4 rounded-lg">Error message</div>', props: { type: "error" } },
      { name: "Warning", code: '<div class="bg-yellow-500 text-white p-4 rounded-lg">Warning message</div>', props: { type: "warning" } },
      { name: "Info", code: '<div class="bg-blue-500 text-white p-4 rounded-lg">Info message</div>', props: { type: "info" } }
