    usage: `<Toast type="success" message="Saved!" />`
  },
  pagination: {
    name: "Pagination",
    icon: "📄",
    description: "Page navigation component for paginated content.",
    category: "Navigation",
    variants: [
      { name: "Basic", code: '<nav class="flex items-center gap-2"><button class="px-3 py-2 rounded bg-gray-200">←</button><button class="px-3 py-2 rounded bg-indigo-600 text-white">1</button><button class="px-3 py-2 rounded bg-gray-100">2</button><button class="px-3 py-2 rounded bg-gray-200">→</button></nav>', props: { current: 1, total: 5 } },
      { name: "Middle Page", code: '<nav class="flex items-center gap-2"><button class="px-3 py-2 rounded bg-gray-200">←</button><button class="px-3 py-2 rounded bg-gray-100">1</button><button class="px-3 py-2 rounded bg-indigo-600 text-white">3</button><button class="px-3 py-2 rounded bg-gray-100">5</button><button class="px-3 py-2 rounded bg-gray-200">→</button></nav>', props: { current: 3, total: 5 } },
      { name: "Last Page", code: '<nav class="flex items-center gap-2"><button class="px-3 py-2 rounded bg-gray-200">←</button><button class="px-3 py-2 rounded bg-gray-100">4</button><button class="px-3 py-2 rounded bg-indigo-600 text-white">5</button><button class="px-3 py-2 rounded bg-gray-200 opacity-50 cursor-not-allowed" disabled>→</button></nav>', props: { current: 5, total: 5 } }
