    api: [
      { prop: "type", type: "string", default: "info", description: "Toast type: success, error, warning, info" },
      { prop: "message", type: "string", default: "-", description: "Toast message" },
      { prop: "position", type: "string", default: "top-right", description: "Toast position" },
      { prop: "duration", type: "number", default: "3000", description: "Auto-dismiss time in ms" }
