---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

export const prerender = true;

const services = [
  {
    icon: "🎨",
    title: "UI/UX Design",
    description: "Beautiful, modern interface designs tailored to your brand and user needs.",
    features: ["Custom Design", "User Research", "Wireframing", "Prototyping", "Design Systems"],
    price: "Custom"
  },
  {
    icon: "⚙️",
    title: "Component Development",
    description: "Production-ready, fully accessible UI components for any framework.",
    features: ["React Components", "Vue Components", "Web Components", "Accessibility", "Documentation"],
    price: "Starting at $500"
  },
  {
    icon: "🔧",
    title: "Web Development",
    description: "Full-stack web applications built with modern technologies and best practices.",
    features: [".NET Backend", "Astro/React Frontend", "Database Design", "API Development", "Deployment"],
    price: "Custom"
  },
  {
    icon: "📱",
    title: "Responsive Design",
    description: "Mobile-first responsive designs that work seamlessly across all devices.",
    features: ["Mobile Design", "Responsive Layout", "Cross-browser Testing", "Performance Optimization", "SEO"],
    price: "Included"
  },
  {
    icon: "🔒",
    title: "Security & Performance",
    description: "Secure authentication, fast load times, and optimized performance.",
    features: ["Authentication", "SSL/TLS", "Performance Audit", "Security Audit", "Monitoring"],
    price: "Custom"
  },
  {
    icon: "📚",
    title: "Documentation & Support",
    description: "Complete documentation and ongoing support for your project.",
    features: ["API Documentation", "Component Docs", "Training", "Support Tickets", "Maintenance"],
    price: "Starting at $200/mo"
  }
];

const processSteps = [
  { number: "01", title: "Discovery", description: "We understand your needs, goals, and target audience." },
  { number: "02", title: "Design", description: "Create beautiful designs and prototypes for your approval." },
  { number: "03", title: "Development", description: "Build with clean, maintainable, and tested code." },
  { number: "04", title: "Testing", description: "Comprehensive testing across browsers and devices." },
  { number: "05", title: "Deployment", description: "Launch your project to production with confidence." },
  { number: "06", title: "Support", description: "Ongoing maintenance and support as you grow." }
];

const whyChooseUs = [
  { title: "Expertise", description: "10+ years of experience in web development and UI design.", icon: "👨‍💼" },
  { title: "Quality", description: "100% accessibility compliant, production-ready code.", icon: "⭐" },
  { title: "Communication", description: "Regular updates and transparent communication throughout.", icon: "💬" },
  { title: "Scalability", description: "Build for growth with scalable architecture and code.", icon: "📈" },
  { title: "Support", description: "Dedicated support team available for your questions.", icon: "🤝" },
  { title: "Innovation", description: "Latest technologies and modern best practices.", icon: "🚀" }
];
---

<BaseLayout title="Services - DevPath" description="Professional web development, UI/UX design, and component development services for your next project.">
  <!-- Hero Section -->
  <section class="bg-linear-to-br from-indigo-600 via-purple-600 to-pink-600 text-white py-24 px-6 mb-20">
    <div class="max-w-5xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">Our Services</h1>
      <p class="text-xl text-indigo-100 mb-8">
        Comprehensive web development and design services to bring your vision to life.
      </p>
      <a href="/contact" class="inline-block bg-white text-indigo-600 px-8 py-3 rounded-lg font-bold hover:bg-indigo-50 transition">
        Get a Quote
      </a>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-6 mb-20">
    <!-- Services Grid -->
    <section class="mb-20">
      <div class="mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">What We Offer</h2>
        <p class="text-lg text-gray-600">Complete solutions for your web and design needs</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service, index) => (
          <div class="group bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-2xl hover:border-indigo-300 transition-all duration-300">
            <!-- Icon -->
            <div class="text-6xl mb-4 group-hover:scale-110 transition-transform">{service.icon}</div>

            <!-- Title -->
            <h3 class="text-2xl font-bold text-gray-900 mb-3">{service.title}</h3>

            <!-- Description -->
            <p class="text-gray-600 mb-6 leading-relaxed">{service.description}</p>

            <!-- Features -->
            <div class="mb-6 pb-6 border-b border-gray-200">
              <div class="space-y-2">
                {service.features.map(feature => (
                  <div class="flex items-center gap-2">
                    <span class="text-indigo-600 font-bold">✓</span>
                    <span class="text-gray-700 text-sm">{feature}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Price -->
            <div class="flex items-center justify-between">
              <span class="text-lg font-bold text-gray-900">{service.price}</span>
              <a href="/contact" class="text-indigo-600 hover:text-purple-600 font-semibold transition">
                Learn More →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="mb-20">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Why Choose DevPath?</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          We combine expertise, quality, and innovation to deliver exceptional results.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {whyChooseUs.map(reason => (
          <div class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition">
            <div class="text-5xl mb-4">{reason.icon}</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">{reason.title}</h3>
            <p class="text-gray-600">{reason.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Process Section -->
    <section class="mb-20">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Our Process</h2>
        <p class="text-lg text-gray-600">A structured approach to delivering excellent results</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {processSteps.map((step, index) => (
          <div class="relative">
            <!-- Connector Line -->
            {index < processSteps.length - 1 && (
              <div class="hidden lg:block absolute top-20 left-[55%] w-[calc(100%+2rem)] h-1 bg-gradient-to-r from-indigo-600 to-purple-600"></div>
            )}

            <!-- Step Card -->
            <div class="relative bg-white rounded-2xl border-2 border-indigo-300 p-8 text-center hover:shadow-lg transition">
              <div class="absolute -top-6 left-1/2 transform -translate-x-1/2">
                <div class="bg-gradient-to-br from-indigo-600 to-purple-600 text-white w-12 h-12 rounded-full flex items-center justify-center font-bold text-lg">
                  {step.number}
                </div>
              </div>

              <h3 class="text-xl font-bold text-gray-900 mb-3 mt-4">{step.title}</h3>
              <p class="text-gray-600">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pricing Comparison -->
    <section class="mb-20">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Flexible Pricing</h2>
        <p class="text-lg text-gray-600">Choose the plan that fits your needs</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Starter -->
        <div class="bg-white rounded-2xl border-2 border-gray-200 p-8 hover:shadow-xl transition">
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Starter</h3>
          <p class="text-gray-600 mb-6">Perfect for small projects</p>
          <div class="text-4xl font-bold text-indigo-600 mb-8">$500<span class="text-lg text-gray-600">/project</span></div>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <span class="text-indigo-600">✓</span>
              <span class="text-gray-700">5 Components</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-indigo-600">✓</span>
              <span class="text-gray-700">Basic Design</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-indigo-600">✓</span>
              <span class="text-gray-700">Documentation</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-indigo-600">✓</span>
              <span class="text-gray-700">2 Weeks Support</span>
            </li>
          </ul>
          <button class="w-full border-2 border-indigo-600 text-indigo-600 py-3 rounded-lg font-bold hover:bg-indigo-50 transition">
            Choose Plan
          </button>
        </div>

        <!-- Professional (Featured) -->
        <div class="bg-gradient-to-br from-indigo-600 to-purple-600 rounded-2xl p-8 text-white md:scale-105 hover:shadow-2xl transition">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-yellow-400 text-gray-900 px-4 py-1 rounded-full text-sm font-bold">
            MOST POPULAR
          </div>
          <h3 class="text-2xl font-bold mb-2 mt-4">Professional</h3>
          <p class="text-indigo-100 mb-6">Recommended for most projects</p>
          <div class="text-4xl font-bold mb-8">$1,500<span class="text-lg text-indigo-100">/project</span></div>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <span>✓</span>
              <span>15 Components</span>
            </li>
            <li class="flex items-center gap-3">
              <span>✓</span>
              <span>Custom Design</span>
            </li>
            <li class="flex items-center gap-3">
              <span>✓</span>
              <span>Full Documentation</span>
            </li>
            <li class="flex items-center gap-3">
              <span>✓</span>
              <span>1 Month Support</span>
            </li>
            <li class="flex items-center gap-3">
              <span>✓</span>
              <span>Responsive Design</span>
            </li>
          </ul>
          <button class="w-full bg-white text-indigo-600 py-3 rounded-lg font-bold hover:bg-indigo-50 transition">
            Choose Plan
          </button>
        </div>

        <!-- Enterprise -->
        <div class="bg-white rounded-2xl border-2 border-gray-200 p-8 hover:shadow-xl transition">
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Enterprise</h3>
          <p class="text-gray-600 mb-6">For large-scale projects</p>
          <div class="text-4xl font-bold text-indigo-600 mb-8">Custom<span class="text-lg text-gray-600">/pricing</span></div>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <span class="text-indigo-600">✓</span>
              <span class="text-gray-700">Unlimited Components</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-indigo-600">✓</span>
              <span class="text-gray-700">Full Design System</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-indigo-600">✓</span>
              <span class="text-gray-700">Complete Documentation</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-indigo-600">✓</span>
              <span class="text-gray-700">Ongoing Support</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-indigo-600">✓</span>
              <span class="text-gray-700">Dedicated Account Manager</span>
            </li>
          </ul>
          <a href="/contact" class="w-full block text-center bg-indigo-600 text-white py-3 rounded-lg font-bold hover:bg-indigo-700 transition">
            Contact Us
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-linear-to-br from-indigo-600 via-purple-600 to-pink-600 rounded-2xl p-12 text-white text-center mb-16">
      <h2 class="text-4xl font-bold mb-4">Ready to Get Started?</h2>
      <p class="text-lg text-indigo-100 mb-8 max-w-2xl mx-auto">
        Let's discuss your project and find the perfect service for your needs.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/contact" class="bg-white text-indigo-600 px-8 py-3 rounded-lg font-bold hover:bg-indigo-50 transition">
          Request a Quote
        </a>
        <a href="/components" class="border-2 border-white text-white px-8 py-3 rounded-lg font-bold hover:bg-white/10 transition">
          View Components
        </a>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-20">
      <h2 class="text-4xl font-bold text-gray-900 text-center mb-12">Frequently Asked Questions</h2>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl border border-gray-200 p-8">
          <h3 class="text-lg font-bold text-gray-900 mb-3">What's your typical project timeline?</h3>
          <p class="text-gray-600">Most projects take 4-8 weeks depending on complexity. We'll provide a detailed timeline during the discovery phase.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 p-8">
          <h3 class="text-lg font-bold text-gray-900 mb-3">Do you offer revisions?</h3>
          <p class="text-gray-600">Yes! Each plan includes a set number of revision rounds to ensure you're completely satisfied with the result.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 p-8">
          <h3 class="text-lg font-bold text-gray-900 mb-3">What technologies do you use?</h3>
          <p class="text-gray-600">We use modern technologies including .NET, Astro, React, TypeScript, and Tailwind CSS for optimal results.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 p-8">
          <h3 class="text-lg font-bold text-gray-900 mb-3">Do you provide ongoing support?</h3>
          <p class="text-gray-600">Yes! We offer support packages ranging from 2 weeks to ongoing monthly maintenance plans.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 p-8">
          <h3 class="text-lg font-bold text-gray-900 mb-3">Can you work with existing projects?</h3>
          <p class="text-gray-600">Absolutely! We can integrate with your existing codebase, improve components, or take over maintenance.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 p-8">
          <h3 class="text-lg font-bold text-gray-900 mb-3">How do we get started?</h3>
          <p class="text-gray-600">Simply contact us to schedule a discovery call. We'll discuss your needs and provide a custom quote.</p>
        </div>
      </div>
    </section>
  </div>

  <Footer />
</BaseLayout>
